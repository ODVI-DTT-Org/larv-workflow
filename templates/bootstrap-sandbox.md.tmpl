# Bootstrap Sandbox — {{project_slug}}

> Run this before implementing the first slice. This file is self-contained and does not require the larv plugin.

## Purpose

Allocate VM runtime resources, copy the project to the VM, run `docs/larv/07-runtime/deploy-sandbox.sh`, probe the app from inside and outside the VM, then write the sandbox URL back into project docs.

## Required local files

- `docs/larv/STATE.yaml`
- `docs/larv/07-runtime/deploy-sandbox.sh`
- `docs/Handsoff.md`
- `docs/Handsoff/slice-NN-*.md`

## Bootstrap commands

```bash
set -euo pipefail

VM_HOST="{{vm_host}}"
SSH_USER="{{ssh_user}}"
SLUG="{{project_slug}}"
SSH_TARGET="$SSH_USER@$VM_HOST"
PROJECT_ROOT="/srv/larv/$SLUG"
DB_NAME="larv_${SLUG//-/_}"
DB_CONNECTION="${DB_CONNECTION:-mysql}"
DB_HOST="${DB_HOST:-127.0.0.1}"
DB_PORT="${DB_PORT:-}"
DB_USERNAME="${DB_USERNAME:-larv}"
DB_PASSWORD="${DB_PASSWORD:-}"
DB_INSTALL_MODE="${DB_INSTALL_MODE:-fail}"

if [ ! -x docs/larv/07-runtime/deploy-sandbox.sh ]; then
    echo "ERROR: docs/larv/07-runtime/deploy-sandbox.sh is missing or not executable" >&2
    exit 1
fi

if ! command -v ssh >/dev/null || ! command -v rsync >/dev/null || ! command -v yq >/dev/null; then
    echo "ERROR: local ssh, rsync, and yq are required" >&2
    exit 1
fi

ssh -o BatchMode=yes -o ConnectTimeout=5 "$SSH_TARGET" \
    "command -v php >/dev/null && command -v tmux >/dev/null && command -v curl >/dev/null && command -v rsync >/dev/null && command -v ss >/dev/null"

if [ "$DB_CONNECTION" = "pgsql" ]; then
    DB_PORT="${DB_PORT:-5432}"
    if ! ssh "$SSH_TARGET" "command -v psql >/dev/null && command -v createdb >/dev/null"; then
        if [ "$DB_INSTALL_MODE" = "apt" ]; then
            ssh "$SSH_TARGET" "sudo apt-get update && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y postgresql postgresql-contrib"
        else
            echo "ERROR: PostgreSQL tools are missing on the VM. Install PostgreSQL or rerun with DB_INSTALL_MODE=apt." >&2
            exit 1
        fi
    fi
    ssh "$SSH_TARGET" "if command -v systemctl >/dev/null && systemctl list-unit-files | grep -q '^postgresql'; then sudo systemctl start postgresql; fi"
    ssh "$SSH_TARGET" "command -v psql >/dev/null && command -v createdb >/dev/null"
    ssh "$SSH_TARGET" "sudo -u postgres psql -tAc \"SELECT 1 FROM pg_roles WHERE rolname='$DB_USERNAME'\" | grep -q 1 || sudo -u postgres psql -c \"CREATE ROLE $DB_USERNAME LOGIN PASSWORD '$DB_PASSWORD'\""
    ssh "$SSH_TARGET" "sudo -u postgres psql -tAc \"SELECT 1 FROM pg_database WHERE datname='$DB_NAME'\" | grep -q 1 || sudo -u postgres createdb '$DB_NAME'"
    ssh "$SSH_TARGET" "sudo -u postgres psql -c \"ALTER DATABASE $DB_NAME OWNER TO $DB_USERNAME\""
elif [ "$DB_CONNECTION" = "mysql" ] || [ "$DB_CONNECTION" = "mariadb" ]; then
    DB_PORT="${DB_PORT:-3306}"
    if ! ssh "$SSH_TARGET" "command -v mysql >/dev/null"; then
        if [ "$DB_INSTALL_MODE" = "apt" ]; then
            ssh "$SSH_TARGET" "sudo apt-get update && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y mariadb-server"
        else
            echo "ERROR: MySQL/MariaDB client/server tools are missing on the VM. Install MariaDB/MySQL or rerun with DB_INSTALL_MODE=apt." >&2
            exit 1
        fi
    fi
    ssh "$SSH_TARGET" "if command -v systemctl >/dev/null; then if systemctl list-unit-files | grep -q '^mysql'; then sudo systemctl start mysql; elif systemctl list-unit-files | grep -q '^mariadb'; then sudo systemctl start mariadb; fi; fi"
    ssh "$SSH_TARGET" "command -v mysql >/dev/null"
    ssh "$SSH_TARGET" "mysql -N -B -e \"CREATE DATABASE IF NOT EXISTS \\`$DB_NAME\\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci; CREATE USER IF NOT EXISTS '$DB_USERNAME'@'localhost' IDENTIFIED BY '$DB_PASSWORD'; CREATE USER IF NOT EXISTS '$DB_USERNAME'@'%' IDENTIFIED BY '$DB_PASSWORD'; GRANT ALL PRIVILEGES ON \\`$DB_NAME\\`.* TO '$DB_USERNAME'@'localhost'; GRANT ALL PRIVILEGES ON \\`$DB_NAME\\`.* TO '$DB_USERNAME'@'%'; FLUSH PRIVILEGES;\""
else
    echo "ERROR: DB_CONNECTION must be mysql, mariadb, or pgsql" >&2
    exit 1
fi

if [ ! -f .env ] && [ -f .env.example ]; then
    cp .env.example .env
fi
touch .env
upsert_env() {
    local key="$1"
    local value="$2"
    if grep -q "^${key}=" .env; then
        sed -i "s|^${key}=.*|${key}=${value}|" .env
    else
        printf "%s=%s\n" "$key" "$value" >> .env
    fi
}
upsert_env APP_ENV local
upsert_env APP_DEBUG true
upsert_env DB_CONNECTION "$DB_CONNECTION"
upsert_env DB_HOST "$DB_HOST"
upsert_env DB_PORT "$DB_PORT"
upsert_env DB_DATABASE "$DB_NAME"
upsert_env DB_USERNAME "$DB_USERNAME"
upsert_env DB_PASSWORD "$DB_PASSWORD"

listening="$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$SSH_TARGET" "ss -tlnp 2>/dev/null" 2>/dev/null \
    | awk '{print $4}' | awk -F: '{print $NF}' | sort -un)"

APP_PORT=""
for port in $(seq 8000 8999); do
    if ! grep -qx "$port" <<<"$listening"; then
        APP_PORT="$port"
        break
    fi
done

if [ -z "$APP_PORT" ]; then
    echo "ERROR: no free app port in 8000-8999" >&2
    exit 1
fi

ssh "$SSH_TARGET" "if command -v ufw >/dev/null; then sudo ufw allow '$APP_PORT'/tcp >/dev/null; fi"

ssh "$SSH_TARGET" "mkdir -p '$PROJECT_ROOT'"
rsync -avz --delete \
    --exclude .git \
    --exclude docs/larv/07-runtime/sandbox-url.txt \
    ./ "$SSH_TARGET:$PROJECT_ROOT/app/"

APP_URL="http://$VM_HOST:$APP_PORT/"
upsert_env APP_URL "$APP_URL"
rsync -avz .env "$SSH_TARGET:$PROJECT_ROOT/app/.env"

ssh "$SSH_TARGET" "cd '$PROJECT_ROOT/app' && APP_PORT='$APP_PORT' DB_DATABASE='$DB_NAME' bash docs/larv/07-runtime/deploy-sandbox.sh"

for attempt in $(seq 1 6); do
    if ssh "$SSH_TARGET" "curl -fsS --max-time 5 -o /dev/null 'http://127.0.0.1:$APP_PORT/'"; then
        break
    fi
    if [ "$attempt" -eq 6 ]; then
        echo "ERROR: inside-VM app probe failed on port $APP_PORT" >&2
        exit 1
    fi
    sleep 10
done

for attempt in $(seq 1 6); do
    if curl -fsS --max-time 5 -o /dev/null "$APP_URL"; then
        break
    fi
    if [ "$attempt" -eq 6 ]; then
        echo "ERROR: external app probe failed at $APP_URL" >&2
        exit 1
    fi
    sleep 10
done

mkdir -p docs/larv/07-runtime
printf "%s\n" "$APP_URL" > docs/larv/07-runtime/sandbox-url.txt
cat > docs/larv/07-runtime/sandbox-runbook.md <<EOF
# Sandbox Runbook — $SLUG

App URL: $APP_URL
DB: $DB_NAME
DB connection: $DB_CONNECTION
DB host: $DB_HOST
DB port: $DB_PORT
DB username: $DB_USERNAME
Project root: $PROJECT_ROOT
SSH: ssh $SSH_TARGET
EOF

export APP_PORT DB_NAME PROJECT_ROOT APP_URL DB_CONNECTION DB_HOST DB_PORT DB_USERNAME
yq -i '
  .execution.allocations += [
    {"kind":"app-port","value": strenv(APP_PORT)},
    {"kind":"db-name","value": strenv(DB_NAME)},
    {"kind":"project-root","value": strenv(PROJECT_ROOT)}
  ] |
  .sandbox.app_url = strenv(APP_URL) |
  .sandbox.status = "provisioned" |
  .sandbox.database.connection = strenv(DB_CONNECTION) |
  .sandbox.database.host = strenv(DB_HOST) |
  .sandbox.database.port = strenv(DB_PORT) |
  .sandbox.database.name = strenv(DB_NAME) |
  .sandbox.database.username = strenv(DB_USERNAME) |
  .project.last_updated_at = "'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"
' docs/larv/STATE.yaml

echo "Sandbox ready at $APP_URL"
```

