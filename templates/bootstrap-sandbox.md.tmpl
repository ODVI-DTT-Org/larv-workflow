# Bootstrap Sandbox — {{project_slug}}

> Run this before implementing the first slice. This file is self-contained and does not require the larv plugin.

## Purpose

Allocate local VM runtime resources, create a bare Laravel scaffold when this is a greenfield docs-only project, run `docs/larv/07-runtime/deploy-sandbox.sh` from the current project directory, probe the app from inside and outside the VM, then write the sandbox URL back into project docs. This assumes the AI is already running on the sandbox VM and that this file is being executed from the project root.

## Required local files

- `docs/larv/STATE.yaml`
- `docs/larv/07-runtime/deploy-sandbox.sh`
- `docs/Handsoff.md`
- `docs/Handsoff/slice-NN-*.md`

## Bootstrap commands

```bash
set -euo pipefail

VM_HOST="{{vm_host}}"
SLUG="{{project_slug}}"
PROJECT_ROOT="$(pwd -P)"
APP_ROOT="$PROJECT_ROOT"
DB_NAME="larv_${SLUG//-/_}"
DB_CONNECTION="${DB_CONNECTION:-pgsql}"
DB_HOST="${DB_HOST:-127.0.0.1}"
DB_PORT="${DB_PORT:-5432}"
DB_USERNAME="${DB_USERNAME:-larv}"
DB_PASSWORD="${DB_PASSWORD:-}"
DB_INSTALL_MODE="${DB_INSTALL_MODE:-apt}"
LARV_VM_INSTALL_MODE="${LARV_VM_INSTALL_MODE:-apt}"

if [ -z "$DB_PASSWORD" ]; then
    DB_PASSWORD="$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32)"
fi

if [ "${LARV_RUNTIME_MODE:-local}" != "local" ]; then
    echo "ERROR: this handoff expects local execution on the sandbox VM. Do not SSH to $VM_HOST unless a separate remote-mode runbook was generated." >&2
    exit 1
fi

if [ "$DB_CONNECTION" != "pgsql" ]; then
    echo "ERROR: larv sandbox bootstrap is PostgreSQL-only. Set DB_CONNECTION=pgsql or leave it unset." >&2
    exit 1
fi

if [ ! -x docs/larv/07-runtime/deploy-sandbox.sh ]; then
    echo "ERROR: docs/larv/07-runtime/deploy-sandbox.sh is missing or not executable" >&2
    exit 1
fi

install_vm_packages_if_missing() {
    missing_runtime=()
    command -v php >/dev/null || missing_runtime+=(php-cli php-xml php-mbstring php-curl php-zip php-pgsql)
    command -v composer >/dev/null || missing_runtime+=(composer unzip)
    command -v curl >/dev/null || missing_runtime+=(curl)
    command -v ss >/dev/null || missing_runtime+=(iproute2)
    command -v setsid >/dev/null || missing_runtime+=(util-linux)
    command -v flock >/dev/null || missing_runtime+=(util-linux)
    command -v rsync >/dev/null || missing_runtime+=(rsync)
    if [ "${#missing_runtime[@]}" -gt 0 ]; then
        if [ "$LARV_VM_INSTALL_MODE" = "apt" ]; then
            sudo apt-get update
            sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing_runtime[@]}"
        else
            echo "ERROR: missing runtime tools/packages: ${missing_runtime[*]}. Rerun with LARV_VM_INSTALL_MODE=apt to auto-install." >&2
            exit 1
        fi
    fi

    if ! command -v yq >/dev/null; then
        if [ "$LARV_VM_INSTALL_MODE" = "apt" ]; then
            arch="$(uname -m)"
            case "$arch" in
                x86_64|amd64) yq_arch=amd64 ;;
                aarch64|arm64) yq_arch=arm64 ;;
                *) echo "ERROR: unsupported architecture for yq auto-install: $arch" >&2; exit 1 ;;
            esac
            sudo curl -fsSL "https://github.com/mikefarah/yq/releases/download/v4.44.3/yq_linux_${yq_arch}" -o /usr/local/bin/yq
            sudo chmod +x /usr/local/bin/yq
        else
            echo "ERROR: yq is missing. Rerun with LARV_VM_INSTALL_MODE=apt to auto-install mikefarah/yq." >&2
            exit 1
        fi
    fi

    if grep -Eq '(^|[[:space:]])docker([[:space:]]|$)|docker compose|docker-compose' docs/larv/07-runtime/deploy-sandbox.sh; then
        if ! command -v docker >/dev/null || ! docker compose version >/dev/null 2>&1; then
            if [ "$LARV_VM_INSTALL_MODE" = "apt" ]; then
                sudo apt-get update
                sudo DEBIAN_FRONTEND=noninteractive apt-get install -y docker.io docker-compose-plugin || \
                    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y docker.io docker-compose
                if command -v systemctl >/dev/null; then sudo systemctl start docker || true; fi
                sudo usermod -aG docker "$(whoami)" || true
                sudo chmod 666 /var/run/docker.sock 2>/dev/null || true
            else
                echo "ERROR: deploy-sandbox.sh uses Docker, but docker/compose is unavailable. Rerun with LARV_VM_INSTALL_MODE=apt to auto-install." >&2
                exit 1
            fi
        fi
    fi
}

install_vm_packages_if_missing

if ! command -v php >/dev/null || ! command -v composer >/dev/null || ! command -v curl >/dev/null || ! command -v ss >/dev/null || ! command -v setsid >/dev/null || ! command -v yq >/dev/null || ! command -v flock >/dev/null; then
    echo "ERROR: php, composer, curl, ss, setsid, yq, and flock are required on this VM after auto-install. Install missing tools or set LARV_VM_INSTALL_MODE=apt." >&2
    exit 1
fi

ensure_laravel_scaffold() {
    if [ -f artisan ]; then
        return 0
    fi
    if [ "${LARV_SCAFFOLD_ON_BOOTSTRAP:-auto}" = "never" ]; then
        echo "ERROR: artisan is missing and LARV_SCAFFOLD_ON_BOOTSTRAP=never. Create the Laravel scaffold, then rerun this bootstrap." >&2
        exit 1
    fi
    if ! command -v composer >/dev/null; then
        echo "ERROR: artisan is missing and composer is not installed. Install composer or create the Laravel scaffold, then rerun this bootstrap." >&2
        exit 1
    fi

    echo "Laravel scaffold not found; creating a bare Laravel app in $APP_ROOT before sandbox startup."
    scaffold_tmp="$(mktemp -d)"
    cleanup_scaffold_tmp() { rm -rf "$scaffold_tmp"; }
    trap cleanup_scaffold_tmp RETURN

    composer create-project laravel/laravel "$scaffold_tmp/app" --no-interaction --prefer-dist
    if command -v rsync >/dev/null; then
        rsync -a --exclude='.git' "$scaffold_tmp/app/" "$APP_ROOT/"
    else
        (cd "$scaffold_tmp/app" && tar cf - .) | (cd "$APP_ROOT" && tar xf -)
    fi
    rm -rf "$scaffold_tmp"
    trap - RETURN

    if [ ! -f artisan ]; then
        echo "ERROR: Laravel scaffold completed but artisan is still missing in $APP_ROOT" >&2
        exit 1
    fi
}

ensure_laravel_scaffold

if ! command -v psql >/dev/null || ! command -v createdb >/dev/null; then
    if [ "$DB_INSTALL_MODE" = "apt" ]; then
        sudo apt-get update && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y postgresql postgresql-contrib
    else
        echo "ERROR: PostgreSQL tools are missing. Install PostgreSQL or rerun with DB_INSTALL_MODE=apt." >&2
        exit 1
    fi
fi
if command -v systemctl >/dev/null && systemctl list-unit-files | grep -q '^postgresql'; then sudo systemctl start postgresql; fi
command -v psql >/dev/null && command -v createdb >/dev/null
sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname='$DB_USERNAME'" | grep -q 1 || sudo -u postgres psql -c "CREATE ROLE \"$DB_USERNAME\" LOGIN PASSWORD '$DB_PASSWORD'"
if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname='$DB_NAME'" | grep -q 1; then
    sudo -u postgres createdb -O "$DB_USERNAME" "$DB_NAME"
else
    sudo -u postgres psql -c "ALTER DATABASE \"$DB_NAME\" OWNER TO \"$DB_USERNAME\""
fi

if [ ! -f .env ] && [ -f .env.example ]; then
    cp .env.example .env
fi
touch .env
upsert_env() {
    local key="$1"
    local value="$2"
    if grep -q "^${key}=" .env; then
        sed -i "s|^${key}=.*|${key}=${value}|" .env
    else
        printf "%s=%s\n" "$key" "$value" >> .env
    fi
}
upsert_env APP_ENV local
upsert_env APP_DEBUG true
upsert_env DB_CONNECTION "$DB_CONNECTION"
upsert_env DB_HOST "$DB_HOST"
upsert_env DB_PORT "$DB_PORT"
upsert_env DB_DATABASE "$DB_NAME"
upsert_env DB_USERNAME "$DB_USERNAME"
upsert_env DB_PASSWORD "$DB_PASSWORD"

PORT_RESERVATION_BASE="${LARV_PORT_RESERVATION_DIR:-/tmp/larv-port-reservations}"
PORT_RESERVATION_DIR="$PORT_RESERVATION_BASE/app"
PORT_RESERVATION_LOCK="$PORT_RESERVATION_BASE/.lock"
PORT_RESERVATION_TTL_SECONDS="${LARV_PORT_RESERVATION_TTL_SECONDS:-21600}"
mkdir -p "$PORT_RESERVATION_DIR"

reservation_is_stale() {
    local file="$1" created_at now
    [ -f "$file" ] || return 0
    created_at="$(awk -F= '$1 == "created_at" {print $2}' "$file" 2>/dev/null | head -1)"
    case "$created_at" in
        ''|*[!0-9]*) return 0 ;;
    esac
    now="$(date +%s)"
    [ $((now - created_at)) -gt "$PORT_RESERVATION_TTL_SECONDS" ]
}

listening="$(ss -tlnp 2>/dev/null | awk '{print $4}' | awk -F: '{print $NF}' | sort -un)"

echo "Before exposing the app sandbox, ask the user which public VM app port they want."
echo "Valid range: 8000-8999. They may choose 'auto' for automatic allocation."
REQUESTED_APP_PORT="${LARV_APP_PORT:-}"
if [ -z "$REQUESTED_APP_PORT" ] && [ -t 0 ] && [ -r /dev/tty ] && [ -w /dev/tty ]; then
    printf "Choose app sandbox port (8000-8999). Press Enter for automatic allocation: " > /dev/tty
    IFS= read -r REQUESTED_APP_PORT < /dev/tty || REQUESTED_APP_PORT=""
fi
if [ "$REQUESTED_APP_PORT" = "auto" ]; then
    REQUESTED_APP_PORT=""
fi
if [ -n "$REQUESTED_APP_PORT" ]; then
    case "$REQUESTED_APP_PORT" in
        ''|*[!0-9]*) echo "ERROR: requested app port must be numeric or auto" >&2; exit 1 ;;
    esac
    if [ "$REQUESTED_APP_PORT" -lt 8000 ] || [ "$REQUESTED_APP_PORT" -gt 8999 ]; then
        echo "ERROR: requested app port must be in 8000-8999" >&2
        exit 1
    fi
fi

APP_PORT=""
exec 9>"$PORT_RESERVATION_LOCK"
flock 9
if [ -n "$REQUESTED_APP_PORT" ]; then
    reservation_file="$PORT_RESERVATION_DIR/$REQUESTED_APP_PORT"
    if [ -f "$reservation_file" ] && reservation_is_stale "$reservation_file"; then
        rm -f "$reservation_file"
    fi
    if grep -qx "$REQUESTED_APP_PORT" <<<"$listening" || [ -f "$reservation_file" ]; then
        echo "ERROR: requested app port $REQUESTED_APP_PORT is already in use or reserved. Ask the user for another port." >&2
        exit 1
    fi
    {
        printf "owner=%s\n" "$SLUG"
        printf "created_at=%s\n" "$(date +%s)"
        printf "pid=%s\n" "$$"
    } > "$reservation_file"
    APP_PORT="$REQUESTED_APP_PORT"
fi
for port in $(seq 8000 8999); do
    [ -n "$APP_PORT" ] && break
    reservation_file="$PORT_RESERVATION_DIR/$port"
    if [ -f "$reservation_file" ] && reservation_is_stale "$reservation_file"; then
        rm -f "$reservation_file"
    fi
    if ! grep -qx "$port" <<<"$listening" && [ ! -f "$reservation_file" ]; then
        {
            printf "owner=%s\n" "$SLUG"
            printf "created_at=%s\n" "$(date +%s)"
            printf "pid=%s\n" "$$"
        } > "$reservation_file"
        APP_PORT="$port"
        break
    fi
done

if [ -z "$APP_PORT" ]; then
    echo "ERROR: no free app port in 8000-8999" >&2
    exit 1
fi
trap 'rm -f "$PORT_RESERVATION_DIR/${APP_PORT:-__none__}"' EXIT

APP_URL="http://$VM_HOST:$APP_PORT/"
APP_SESSION="larv-app-$SLUG-$APP_PORT"
APP_PID_FILE="${LARV_SANDBOX_PROCESS_DIR:-/tmp/larv-sandbox-processes}/$APP_SESSION.pid"

if command -v ufw >/dev/null; then
    sudo ufw allow "$APP_PORT/tcp" >/dev/null
    sudo ufw status | grep -q "$APP_PORT/tcp" || {
        echo "ERROR: firewall rule for app port $APP_PORT was not confirmed" >&2
        exit 1
    }
else
    echo "WARN: ufw not installed; confirm provider firewall allows TCP $APP_PORT before sharing $APP_URL" >&2
fi

upsert_env APP_URL "$APP_URL"
(cd "$APP_ROOT" && APP_PORT="$APP_PORT" DB_DATABASE="$DB_NAME" LARV_PROJECT_SLUG="$SLUG" LARV_APP_SESSION="$APP_SESSION" LARV_APP_PID_FILE="$APP_PID_FILE" bash docs/larv/07-runtime/deploy-sandbox.sh)

for attempt in $(seq 1 6); do
    if curl -fsS --max-time 5 -o /dev/null "http://127.0.0.1:$APP_PORT/"; then
        break
    fi
    if [ "$attempt" -eq 6 ]; then
        echo "ERROR: inside-VM app probe failed on port $APP_PORT" >&2
        exit 1
    fi
    sleep 10
done

for attempt in $(seq 1 6); do
    if curl -fsS --max-time 5 -o /dev/null "$APP_URL"; then
        break
    fi
    if [ "$attempt" -eq 6 ]; then
        echo "ERROR: external app probe failed at $APP_URL" >&2
        exit 1
    fi
    sleep 10
done

rm -f "$PORT_RESERVATION_DIR/$APP_PORT"
trap - EXIT

case "$APP_URL" in
    http://127.0.0.1:*|http://localhost:*)
        echo "ERROR: refusing to announce local-only URL: $APP_URL" >&2
        exit 1
        ;;
esac

mkdir -p docs/larv/07-runtime
printf "%s\n" "$APP_URL" > docs/larv/07-runtime/sandbox-url.txt
cat > docs/larv/07-runtime/sandbox-runbook.md <<EOF
# Sandbox Runbook — $SLUG

App URL: $APP_URL
DB: $DB_NAME
DB connection: $DB_CONNECTION
DB host: $DB_HOST
DB port: $DB_PORT
DB username: $DB_USERNAME
Project root: $PROJECT_ROOT
App session: $APP_SESSION
App PID file: $APP_PID_FILE
Runtime: local on $VM_HOST as $(whoami)
EOF

export APP_PORT DB_NAME PROJECT_ROOT APP_ROOT APP_URL APP_SESSION APP_PID_FILE DB_CONNECTION DB_HOST DB_PORT DB_USERNAME
yq -i '
  .execution.allocations += [
    {"kind":"app-port","value": strenv(APP_PORT)},
    {"kind":"db-name","value": strenv(DB_NAME)},
    {"kind":"project-root","value": strenv(APP_ROOT)}
  ] |
  .sandbox.app_url = strenv(APP_URL) |
  .sandbox.status = "provisioned" |
  .sandbox.database.connection = strenv(DB_CONNECTION) |
  .sandbox.database.host = strenv(DB_HOST) |
  .sandbox.database.port = strenv(DB_PORT) |
  .sandbox.database.name = strenv(DB_NAME) |
  .sandbox.database.username = strenv(DB_USERNAME) |
  .project.last_updated_at = "'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"
' docs/larv/STATE.yaml

echo "Sandbox ready at $APP_URL"
```

